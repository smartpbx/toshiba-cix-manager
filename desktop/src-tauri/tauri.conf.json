{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchroom",
  "version": "0.1.0",
  "identifier": "com.ewee.switchroom",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Switchroom",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Toshiba Strata CIX manager",
    "longDescription": "Switchroom — read and manage a Toshiba Strata CIX over SNMP from a self-contained native desktop window. The native OS WebView hosts the Python engine, which runs as a bundled sidecar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/switchroom-engine"]
  }
}
